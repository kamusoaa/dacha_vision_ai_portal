импорт СистемаИнтеграций::ОбщиеМодули
импорт СистемаИнтеграций::Справочники::ВнешниеСервисы

@ВПроекте
@НаСервере
метод ПолучениеПочтовыхСообщений()
    знч КлючFTP = ПочтовыйКлиент_Константы.ВНЕШНИЙ_СЕРВИС_FTP
    знч ВнешнийСервисFTP = СистемаИнтеграций.ПолучитьВнешнийСервисПоКлючуПоиска(КлючFTP)
    знч ВнешнийСервисFTPОбъект = ВнешнийСервисFTP.ЗагрузитьОбъект()

    если ВнешнийСервисFTPОбъект.Активность
        пер СписокСообщений = ПолучитьИзображенияИзФайловогоСервера(ВнешнийСервисFTPОбъект)
        СоздатьЭлектронноеПисьмоПоВходящемуФайлу(СписокСообщений)
    иначе
        знч Ключ = ПочтовыйКлиент_Константы.ВНЕШНИЙ_СЕРВИС_GMAIL
        знч ВнешнийСервис = СистемаИнтеграций.ПолучитьВнешнийСервисПоКлючуПоиска(Ключ)

        попытка
            если ВнешнийСервис == Неопределено
                возврат
            ;

            знч ВнешнийСервисОбъект = ВнешнийСервис.ЗагрузитьОбъект()
            если не ВнешнийСервисОбъект.Активность
                возврат
            ;

            пер ДополнительныеПараметры = ВнешнийСервисОбъект.ДополнительныеПараметры.ВСоответствие(
                Элемент -> Элемент.Ключ,
                Элемент -> Элемент.Значение)
            пер ТемаПисьма = ДополнительныеПараметры.Получить("Тема") как Строка
            пер ДатаОтсечки = ДополнительныеПараметры.Получить("ОтсечкаСтарта") как Дата

            знч Аутентификация =
                новый АутентификацияПочтыПоПаролю(ВнешнийСервисОбъект.ИмяПользователя, ВнешнийСервисОбъект.Пароль)
            знч ПараметрыПодключения =
                новый ПараметрыПодключенияImap(ВнешнийСервисОбъект.Адрес, ВнешнийСервисОбъект.Порт, Аутентификация)

            исп Соединение = новый СоединениеImap(ПараметрыПодключения)
            пер Входящие = Соединение.ПолучитьКаталог(ВидКаталогаПочты.Входящие)
            пер Корзина = Соединение.ПолучитьКаталог("[Gmail]/Корзина")

            Входящие.Открыть(РежимОткрытияКаталогаImap.ЧтениеИЗапись)

            пер Письма = ПолучитьПисьмаПоКаталогу(Входящие)

            для Элемент из Письма
                если Элемент.Письмо.ДатаОтправления.ВДатаВремя(ЧасовойПояс.Текущий()).Дата <= ДатаОтсечки или Элемент
                        .Письмо.Тема != ТемаПисьма
                    Входящие.ПереместитьПисьма(новый ЧитаемыйМассив<Число>([Элемент.Uid]), Корзина)
                    продолжить
                ;

                пер ВходящееПисьмо = ПолучитьВходящееПисьмоПоИдентификатору(Элемент.Uid.ВСтроку(), ТемаПисьма)
                если ВходящееПисьмо != Неопределено
                    Входящие.ПереместитьПисьма(новый ЧитаемыйМассив<Число>([Элемент.Uid]), Корзина)
                    продолжить
                ;

                пер ВходящееПисьмоОбъект = новый ВходящееЭлектронноеПисьмо.Объект()
                ВходящееПисьмоОбъект.Дата = ДатаВремя.Сейчас()
                ВходящееПисьмоОбъект.ИдентификаторСообщения = Элемент.Письмо.ИдСообщения
                ВходящееПисьмоОбъект.ИдентификаторНаСервере = Элемент.Uid
                ВходящееПисьмоОбъект.ДатаОтправления = Элемент.Письмо.ДатаОтправления.ВДатаВремя(ЧасовойПояс.Текущий())
                ВходящееПисьмоОбъект.ОтправительАдрес = Элемент.Письмо.Отправитель.Адрес
                ВходящееПисьмоОбъект.Тема = Элемент.Письмо.Тема
                ВходящееПисьмоОбъект.ТекстПисьма = Элемент.Письмо.ПолучитьТекст().Первый().Текст
                ВходящееПисьмоОбъект.Статус = СтатусыВходящихЭлектронныхПисем.Получено

                пер Вложения = Элемент.Письмо.Вложения
                для ЭлементВложения из Вложения
                    ВходящееПисьмоОбъект.Вложения.Добавить(
                ОбъектноеХранилище.Загрузить(
                    ИмяФайла = ЭлементВложения.Название,
                    Байты = ЭлементВложения.Данные,
                    Свойства = новый ДвоичныйОбъект.Свойства("{ЭлементВложения.Название}").Временные()).Ссылка)
                ;

                ВходящееПисьмоОбъект.Записать()
                Входящие.ПереместитьПисьма(новый ЧитаемыйМассив<Число>([Элемент.Uid]), Корзина)
            ;
        поймать Исключение: Исключение
            новый ОшибкиИмпортаДанных(
            Задание = "Импорт почтовых сообщений",
            ОписаниеОбъекта = Исключение.Описание,
            ОтладочнаяИнформация = Исключение.Причина.ВСтроку(),
            Важность = ВажностьСобытияЖурналаСобытий.Максимальная,
            ХарактерОшибки = ХарактерОшибки.ВнутренняяОшибка).Записать()
        ;
    ;
;

@ВПодсистеме
@НаСервере
метод ПолучитьВходящееПисьмоПоИдентификатору(Uid: Строка, ТемаПоУмолчанию: Строка): ВходящееЭлектронноеПисьмо.Ссылка?
    если Uid.Пусто()
        возврат Неопределено
    ;

    пер Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            ВходящееЭлектронноеПисьмо.Ссылка КАК Ссылка
        ИЗ
            ВходящееЭлектронноеПисьмо КАК ВходящееЭлектронноеПисьмо
        ГДЕ
            ВходящееЭлектронноеПисьмо.ИдентификаторСообщения == %Uid
             И ВходящееЭлектронноеПисьмо.Тема == %ТемаПоУмолчанию
    }

    пер РезультатЗапроса = Запрос.Выполнить().ВМассив()

    если РезультатЗапроса.Размер() == 0
        возврат Неопределено
    ;

    возврат РезультатЗапроса.Первый().Ссылка
;

@НаСервере
метод ПолучитьПисьмаПоКаталогу(Каталог: КаталогПочтыImap): ЧитаемыйМассив<ПисьмоВСоединенииImap>
    если не Каталог.Открыт()
        Каталог.Открыть(РежимОткрытияКаталогаImap.Чтение)
    ;
    если Каталог.МожетСодержатьПисьма()
        пер КоличествоПисем = Каталог.КоличествоПисем()
        если КоличествоПисем >= 50
            возврат Каталог.ПолучитьПисьма(1, 5)
        иначе
            возврат Каталог.ПолучитьНепрочитанныеПисьма()
        ;
    ;
    выбросить новый ИсключениеНедопустимыйАргумент()
;

@ВПодсистеме
@НаСервере
метод ПолучитьИзображенияИзФайловогоСервера(
        ВнешнийСервисОбъект: ВнешниеСервисы.Объект): Массив<ПочтовыйКлиент_Константы.ИзображенияФайловогоХранилища>

    пер СписокСообщений = новый Массив<ПочтовыйКлиент_Константы.ИзображенияФайловогоХранилища>()

    пер ДополнительныеПараметры = ВнешнийСервисОбъект.ДополнительныеПараметры.ВСоответствие(
                Элемент -> Элемент.Ключ,
                Элемент -> Элемент.Значение)
    пер Директория = ДополнительныеПараметры.Получить("ДиректорияКартинок") как Строка
    пер Мусорка = ДополнительныеПараметры.Получить("Мусорка") как Строка

    попытка
        пер ДиректорияТекущегоДня = "${Дата.Сейчас()|ггггММдд}"

        исп ПодключениеFTP = новый СоединениеFtp(Сервер = ВнешнийСервисОбъект.Адрес,
            Пользователь = ВнешнийСервисОбъект.ИмяПользователя, Пароль = ВнешнийСервисОбъект.Пароль,
            Порт = ВнешнийСервисОбъект.Порт, ПассивныйРежим = Истина)

        пер ТекущаяДиректория = "/%ДиректорияТекущегоДня/%Директория"
        знч СписокФайлов = ПодключениеFTP.ПолучитьСписокФайлов(ТекущаяДиректория)
        пер ПоследняяДатаИзменения: Момент

        для ТекущийФайл из СписокФайлов
            если ТекущийФайл.Расширение != "jpg"
                продолжить
            ;

            если ПоследняяДатаИзменения == ТекущийФайл.Изменен
                СписокСообщений.Последний().СписокФайлов.Добавить(ПолучитьВходящийФайл(
                    ТекущийФайл = ТекущийФайл,
                    ТекущаяДиректория = ТекущаяДиректория,
                    ПодключениеFTP = ПодключениеFTP))
            иначе
                
                ПоследняяДатаИзменения = ТекущийФайл.Изменен

                пер НовоеСообщение = новый ПочтовыйКлиент_Константы.ИзображенияФайловогоХранилища()
                НовоеСообщение.Идентификтатор = Ууид.Случайный().ВСтроку()
                НовоеСообщение.ДатаОтправления = ТекущийФайл.Изменен.ВДатаВремя(ЧасовойПояс.Текущий())
                НовоеСообщение.СписокФайлов.Добавить(ПолучитьВходящийФайл(
                    ТекущийФайл = ТекущийФайл,
                    ТекущаяДиректория = ТекущаяДиректория,
                    ПодключениеFTP = ПодключениеFTP))

                СписокСообщений.Добавить(НовоеСообщение)
            ;
            
            ПодключениеFTP.Переместить("%ТекущаяДиректория/${ТекущийФайл.Имя}", "/%Мусорка/${ТекущийФайл.Имя}")
        ;

        /*попытка
            пер ВчерашняяДиректория = "${Дата.Сейчас().ДобавитьДни(-1)|ггггММдд}"
            ПодключениеFTP.УдалитьКаталог("/%ВчерашняяДиректория")
        вконце
        ;*/
        
поймать Исключение: Исключение
    новый ОшибкиИмпортаДанных(
            Задание = "Импорт почтовых сообщений",
            ОписаниеОбъекта = Исключение.Описание,
            ОтладочнаяИнформация = Исключение.Причина.ВСтроку(),
            Важность = ВажностьСобытияЖурналаСобытий.Максимальная,
            ХарактерОшибки = ХарактерОшибки.ВнутренняяОшибка).Записать()
    ;

    возврат СписокСообщений
;

@Локально
@НаСервере
метод ПолучитьВходящийФайл(ТекущийФайл: ФайлFtp, ТекущаяДиректория: Строка,
        ПодключениеFTP: СоединениеFtp): ПочтовыйКлиент_Константы.ВходящийФайл

    пер ВходящийФайл = новый ПочтовыйКлиент_Константы.ВходящийФайл()
    ВходящийФайл.ИмяФайла = ТекущийФайл.Имя
    ВходящийФайл.Размер = ТекущийФайл.Размер.ВКилобайтах()

    пер ПотокЗаписи = новый ВременныйПотокЗаписи()
    ПодключениеFTP.Получить("%ТекущаяДиректория/${ТекущийФайл.Имя}", ПотокЗаписи)

    ВходящийФайл.Файл = ОбъектноеХранилище.Загрузить(
                    ИмяФайла = ВходящийФайл.ИмяФайла,
                    ВходнойПоток = ПотокЗаписи.ОткрытьПотокЧтения(),
                    Свойства = новый ДвоичныйОбъект.Свойства("${ТекущийФайл.Имя}").Временные()).Ссылка

    возврат ВходящийФайл
;

@Локально
@НаСервере
метод СоздатьЭлектронноеПисьмоПоВходящемуФайлу(
        СписокФайлов: Массив<ПочтовыйКлиент_Константы.ИзображенияФайловогоХранилища>)

    для ОписаниеФайла из СписокФайлов
        
        пер ВходящееПисьмоОбъект = новый ВходящееЭлектронноеПисьмо.Объект()
        ВходящееПисьмоОбъект.Дата = ДатаВремя.Сейчас()
        ВходящееПисьмоОбъект.ДатаОтправления = ОписаниеФайла.ДатаОтправления
        ВходящееПисьмоОбъект.ИдентификаторСообщения = ОписаниеФайла.Идентификтатор
        ВходящееПисьмоОбъект.ИдентификаторНаСервере = 0
        ВходящееПисьмоОбъект.ОтправительАдрес = ОписаниеФайла.ОтправительАдрес
        ВходящееПисьмоОбъект.Тема = ОписаниеФайла.Тема
        ВходящееПисьмоОбъект.Статус = СтатусыВходящихЭлектронныхПисем.Получено

        для Файл из ОписаниеФайла.СписокФайлов
            ВходящееПисьмоОбъект.Вложения.Добавить(Файл.Файл)
        ;

        ВходящееПисьмоОбъект.Записать()
    ;
;